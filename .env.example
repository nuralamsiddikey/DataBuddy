# --- App ---
NODE_ENV=development
PORT=3000
GEMINI_API_KEY=your-gemini-api-key

# Where "today" / "this month" begin and end in analytics answers (IANA name).
# Defaults to the server's time zone.
# TIMEZONE=Asia/Dhaka

# --- MongoDB ---
# Matches the credentials below when using docker-compose.yml.
# For a local container without auth use: mongodb://localhost:27017
MONGODB_URI=mongodb://admin:changeme@localhost:27017/?authSource=admin
MONGO_DB_NAME=databuddy

# --- docker-compose.yml only ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_PORT=27017
